# RFID version — run on a different port than the QR app (default 3001)
PORT=3001
CENTRE_NAME=Kumon NDG Learning Centre

# Staff PIN (Roster, Logs, Settings, exports, backups)
# Change this before using with real student/parent data.
STAFF_PIN=change-me

# Parent emails on check-in AND check-out (configure SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Kumon Centre
SMTP_FROM_EMAIL=

EMAIL_ON_CHECKIN=true
EMAIL_ON_CHECKOUT=true

# Weekly staff punch report (comma-separated; accountant + centre)
ACCOUNTANT_EMAIL=Nassershayan@gmail.com, montreal-ndg@ikumon.com
STAFF_REPORT_AUTO_WEEKLY=false

# Automatic daily backups (while npm start is running)
# Set this to a OneDrive or Google Drive folder on the Windows laptop, e.g.:
# BACKUP_CLOUD_FOLDER=C:\Users\Kumon\OneDrive\Kumon-backups
BACKUP_CLOUD_FOLDER=
AUTO_BACKUP_DAILY=true
