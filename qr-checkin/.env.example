# Server
PORT=3000
CENTRE_NAME=Kumon NDG Learning Centre

# Staff PIN (required for Roster, Logs, Settings, exports, backups)
# Change this before using with real student/parent data.
STAFF_PIN=change-me

# Parent email alerts via SMTP (optional — app works without these)
# For Gmail: enable 2-Step Verification, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Kumon Centre
SMTP_FROM_EMAIL=

# Default email toggles (can also be changed in Settings)
EMAIL_ON_CHECKIN=true
EMAIL_ON_CHECKOUT=true
